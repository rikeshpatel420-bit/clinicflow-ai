//@version=6
strategy("Semi Trend Pullback v1", overlay=true, calc_on_every_tick=false, process_orders_on_close=true, initial_capital=100000)

strategyVersion = "1.0.0"
supportedSymbol = syminfo.ticker == "SMGB" or syminfo.ticker == "SMH" or syminfo.ticker == "SOXX" or syminfo.ticker == "MU" or syminfo.ticker == "AMD" or syminfo.ticker == "NVDA" or syminfo.ticker == "AVGO" or syminfo.ticker == "TSM" or syminfo.ticker == "ASML"

fastEma = ta.ema(close, 21)
slowEma = ta.ema(close, 55)
trendEma = ta.ema(close, 200)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)

trendUp = close > trendEma and fastEma > slowEma
trendDown = close < trendEma and fastEma < slowEma
pullbackBuy = trendUp and low <= fastEma and close > fastEma and rsi > 45 and rsi < 68
exitSell = trendDown or close < slowEma
reduceSignal = strategy.position_size > 0 and close > strategy.position_avg_price + (2.0 * atr)
buySignal = supportedSymbol and barstate.isconfirmed and pullbackBuy and strategy.position_size <= 0
sellSignal = supportedSymbol and barstate.isconfirmed and exitSell and strategy.position_size > 0
holdSignal = supportedSymbol and barstate.isconfirmed and not buySignal and not sellSignal and not reduceSignal

jsonMessage(action, quantity) =>
    '{"secret":"{{WEBHOOK_SECRET}}","event_id":"' + action + '-' + syminfo.ticker + '-' + str.tostring(time) + '","strategy":"semi_trend_pullback_v1","strategy_version":"' + strategyVersion + '","ticker":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","timeframe":"' + timeframe.period + '","action":"' + action + '","price":"' + str.tostring(close) + '","quantity":"' + str.tostring(quantity) + '","bar_time":"' + str.tostring(time) + '","triggered_at":"' + str.tostring(timenow) + '"}'

if buySignal
    strategy.entry("BUY", strategy.long, qty=1, alert_message=jsonMessage("BUY", 1))

if reduceSignal
    strategy.order("REDUCE", strategy.short, qty=math.max(1, math.round(math.abs(strategy.position_size) / 2)), alert_message=jsonMessage("REDUCE", math.max(1, math.round(math.abs(strategy.position_size) / 2))))

if sellSignal
    strategy.close("BUY", alert_message=jsonMessage("SELL", math.abs(strategy.position_size)))

alertcondition(buySignal, title="BUY", message="Use the strategy order fill alert message JSON.")
alertcondition(sellSignal, title="SELL", message="Use the strategy order fill alert message JSON.")
alertcondition(reduceSignal, title="REDUCE", message="Use the strategy order fill alert message JSON.")
alertcondition(holdSignal, title="HOLD", message="Confirmed bar HOLD. No order instruction is created.")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(trendEma, color=color.new(color.gray, 20), title="Trend EMA")
